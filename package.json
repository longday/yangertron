{
  "name": "yangertron",
  "private": true,
  "version": "1.0.0",
  "description": "Unofficial Yandex 360 Messenger desktop client built with Electron and Vite.",
  "author": "longday <6600gm@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:app && pnpm exec electron dist/main.js",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:app": "pnpm run build:main && pnpm run build:preload",
    "build": "tsc && pnpm run build:app && node --disable-warning=DEP0190 ./node_modules/electron-builder/cli.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.main.config.ts vite.preload.config.ts",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-electron": "7.0.0",
    "eslint-plugin-prettier": "5.5.5",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "8.0.13"
  },
  "main": "dist/main.js",
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
